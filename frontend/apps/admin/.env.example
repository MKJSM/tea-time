# Base URL of the Tea Time API.
# Leave empty in development — the Vite dev-server proxy will forward /api/* to the backend.
# In production set this to the backend origin, e.g. https://api.example.com
VITE_API_BASE=

# Backend origin used by the Vite dev-server proxy (development only).
# Defaults to http://127.0.0.1:3001 when not set.
VITE_BACKEND_ORIGIN=http://127.0.0.1:3001
