# Copy this file to .env and fill in real values before running.

DATABASE_URL=postgres://user:password@localhost:5432/mobiletea
DATABASE_POOL_SIZE=5
PORT=3001

# Set to 0.0.0.0 in production to accept external traffic
BIND_ADDR=127.0.0.1

# Comma-separated allowed origins for CORS. Leave blank to allow same-origin only.
CORS_ORIGIN=http://localhost:5173

# Admin seed credentials — CHANGE THESE before deploying

# Razorpay credentials (from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_<your_key_id>
RAZORPAY_KEY_SECRET=<your_key_secret>
RAZORPAY_WEBHOOK_SECRET=<your_webhook_secret>

# AWS S3 (or compatible) for file uploads
AWS_S3_BUCKET=teatime-uploads
AWS_REGION=ap-south-1
AWS_S3_ENDPOINT=                # leave blank for real AWS; set for MinIO/Cloudflare R2
S3_PUBLIC_URL=                  # public base URL for uploaded files

# Max single upload size in bytes (default 20 MB)
MAX_UPLOAD_SIZE=20971520
